{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker.js", "src/service-worker"]
}
